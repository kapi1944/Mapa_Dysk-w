<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mapa dysków" Width="1440" Height="900" MinWidth="1050" MinHeight="650" Background="#11151D" Foreground="#E7ECF4" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Tlo" Color="#181E28"/><SolidColorBrush x:Key="Linia" Color="#303949"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7ECF4"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E7ECF4"/><Setter Property="Background" Value="#242D3C"/><Setter Property="BorderBrush" Value="#354156"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Ramka" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ramka" Property="Background" Value="#354561"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#E7ECF4"/><Setter Property="Background" Value="#202838"/><Setter Property="BorderBrush" Value="#354156"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ADB9CF"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,4"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#CAD4E5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#181E28"/><Setter Property="Foreground" Value="#E7ECF4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#181E28"/><Setter Property="AlternatingRowBackground" Value="#1C2430"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="48"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#222B3A"/><Setter Property="Foreground" Value="#93A1BA"/><Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2D4465"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#11151D"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#CAD4E5"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="3,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="TloPozycji" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TloPozycji" Property="Background" Value="#2B405D"/><Setter Property="Foreground" Value="#B9D7FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TloPozycji" Property="Background" Value="#273348"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="#181E28" BorderBrush="#303949" BorderThickness="0,0,0,1"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="MAPA DYSKÓW" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Lokalny indeks • bez usuwania i przenoszenia" FontSize="11" Foreground="#8D9CB6" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Szukaj" Grid.Column="1" VerticalAlignment="Center" Margin="18,0" ToolTip="Szukaj nazwy lub ścieżki w bieżącym widoku"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Wyglad" Content="Wygląd"/><Button x:Name="PorownajWybrane" Content="Porównaj lokalizacje"/><Button x:Name="Odswiez" Content="Odśwież skan" Background="#275686"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="265" MinWidth="220"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="5"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <Border Background="#151B25" BorderBrush="#303949" BorderThickness="0,0,1,0"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SZYBKI PRZEGLĄD" Foreground="#7F8FA9" FontSize="10" FontWeight="Bold" Margin="12,10"/><ListBox x:Name="Sekcje" Grid.Row="1"/><TextBlock Grid.Row="2" Text="DYSKI I FOLDERY" Foreground="#7F8FA9" FontSize="10" FontWeight="Bold" Margin="12,20,12,10"/><TreeView x:Name="Drzewo" Grid.Row="3" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/></Grid></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#202838"/>
   <Grid Grid.Column="2" Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button x:Name="Wstecz" Content="←" DockPanel.Dock="Left" ToolTip="Wstecz"/><Button x:Name="Dalej" Content="→" DockPanel.Dock="Left" ToolTip="Dalej"/><Button x:Name="Nadrzedny" Content="↑" DockPanel.Dock="Left" ToolTip="Folder nadrzędny"/><Button x:Name="NowyFolder" Content="Nowy folder" DockPanel.Dock="Right"/><TextBlock x:Name="Naglowek" Text="Największe foldery" FontSize="25" FontWeight="SemiBold" Margin="8,5"/></DockPanel>
    <StackPanel Grid.Row="1"><WrapPanel x:Name="Breadcrumb"/><TextBox x:Name="SciezkaWidoku" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#94A5C0" Margin="0,5,0,10" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,6"><DockPanel><TextBlock x:Name="OpisWidoku" Foreground="#8E9CB3" VerticalAlignment="Center"/><CheckBox x:Name="PokazSystemowe" Content="Pokaż systemowe" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel><WrapPanel VerticalAlignment="Center"><Button x:Name="MenuWyswietl" Content="Wyświetl ▾"/><Button x:Name="MenuSortuj" Content="Sortuj ▾"/><Button x:Name="InformacjeFolderu" Content="Informacje o folderze" ToolTip="Informacje o bieżącym folderze lub dysku"/><ComboBox x:Name="TrybWidoku" Width="168" Visibility="Collapsed"/><WrapPanel x:Name="SterowanieSkala" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="Skala" VerticalAlignment="Center" Margin="0,0,6,0"/><Slider x:Name="SkalaKafelkow" Minimum="70" Maximum="140" Width="125" TickFrequency="5" SmallChange="1" LargeChange="5" VerticalAlignment="Center"/><TextBlock x:Name="OpisSkali" Width="42" VerticalAlignment="Center" Margin="8,0,0,0"/><Button x:Name="Skala75" Content="75%" Padding="6,2"/><Button x:Name="Skala100" Content="100%" Padding="6,2"/><Button x:Name="Skala125" Content="125%" Padding="6,2"/></WrapPanel></WrapPanel></StackPanel>
    <Grid Grid.Row="3"><ListBox x:Name="Kafelki" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/><DataGrid x:Name="Lista"/></Grid>
    <DockPanel Grid.Row="4" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="Poprzednia" Content="‹ Poprzednia"/><TextBlock x:Name="NumerStrony" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="Nastepna" Content="Następna ›"/></StackPanel><TextBlock Text="Ctrl / Shift: zaznaczanie • dwuklik: otwórz" Foreground="#7789A6" FontSize="11" VerticalAlignment="Center"/></DockPanel>
   </Grid>
   <GridSplitter x:Name="SeparatorInformacji" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#202838"/>
   <Border x:Name="PanelSzczegolow" Grid.Column="4" Background="#181E28" BorderBrush="#303949" BorderThickness="1,0,0,0"><DockPanel><Grid DockPanel.Dock="Top" Margin="16,8"><TextBlock Text="PANEL INFORMACJI" VerticalAlignment="Center" Foreground="#A4B2C8" FontSize="11" FontWeight="Bold"/><Button x:Name="ZamknijInformacje" Content="×" HorizontalAlignment="Right" ToolTip="Zamknij Panel informacji"/></Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Szczegoly" Margin="18"><TextBlock Text="Wybierz folder, plik lub grupę duplikatów." Margin="0,24" TextWrapping="Wrap" Foreground="#A4B2C8"/></StackPanel></ScrollViewer></DockPanel></Border>
  </Grid>
  <Border Grid.Row="2" Background="#181E28" BorderBrush="#303949" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock x:Name="Stan" VerticalAlignment="Center" Foreground="#91A5C2" FontSize="11"/><TextBlock Text="Dane z indeksu • tworzenie folderów i zmiana nazw" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#71839F" FontSize="11"/></DockPanel></Border>
 </Grid>
</Window>
